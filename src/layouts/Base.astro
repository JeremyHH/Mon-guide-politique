---
import "../styles/global.css";
import { lien } from "../lib/data";

interface Props {
  titre: string;
  description?: string;
  page: "accueil" | "institutions" | "voter" | "elections" | "methode";
}
const { titre, description = "Comprendre les institutions, savoir voter, comparer les candidats : un guide neutre et sourcé de la vie démocratique française.", page } = Astro.props;
const onglets = [
  ["accueil", "Accueil", "/"],
  ["institutions", "Institutions", "/institutions"],
  ["voter", "Voter", "/voter"],
  ["elections", "Élections", "/elections"],
  ["methode", "Méthode", "/methode"],
] as const;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page === "accueil" ? "Mon guide politique" : `${titre} · Mon guide politique`}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={lien("/")}><span>Mon guide <b>politique</b></span></a>
        <nav class="tabs" aria-label="Sections">
          {onglets.map(([id, nom, href]) => (
            <a href={lien(href)} aria-current={id === page ? "page" : undefined}>{nom}</a>
          ))}
        </nav>
      </div>
      <slot name="bandeau" />
    </header>
    <main class="wrap">
      <section class="page">
        <slot />
      </section>
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>Mon guide politique · site indépendant, sans publicité ni collecte de données. <a href={lien("/methode")}>Méthode et corrections</a></p>
      </div>
    </footer>
  </body>
</html>
