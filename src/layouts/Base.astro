---
import "../styles/global.css";
import { lien } from "../lib/data";

interface Props {
  titre: string;
  description?: string;
  page: "accueil" | "candidats" | "comparer" | "quiz" | "methode";
}
const { titre, description = "Synthèse neutre et sourcée de l'élection présidentielle 2027.", page } = Astro.props;
const onglets = [
  ["accueil", "Accueil", "/"],
  ["candidats", "Candidats", "/candidats"],
  ["comparer", "Comparer", "/comparer"],
  ["quiz", "Quiz", "/quiz"],
  ["methode", "Méthode", "/methode"],
] as const;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page === "accueil" ? "Clair 2027" : `${titre} · Clair 2027`}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={lien("/")}>Clair<b>2027</b></a>
        <nav class="tabs" aria-label="Sections">
          {onglets.map(([id, nom, href]) => (
            <a href={lien(href)} aria-current={id === page ? "page" : undefined}>{nom}</a>
          ))}
        </nav>
      </div>
      <div class="mock">
        <div class="wrap">
          <p>Version de travail : les positions marquées « à vérifier » n'ont pas encore de source et ne doivent pas être citées.</p>
        </div>
      </div>
    </header>
    <main class="wrap">
      <section class="page">
        <slot />
      </section>
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>Clair 2027 · site indépendant, sans publicité ni collecte de données. <a href={lien("/methode")}>Méthode et corrections</a></p>
      </div>
    </footer>
  </body>
</html>
