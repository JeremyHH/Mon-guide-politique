---
import Base from "../../../../layouts/Base.astro";
import Position from "../../../../components/Position.astro";
import BandeauVerif from "../../../../components/BandeauVerif.astro";
import { elections, candidatsDe, nomComplet, slugCandidat, STATUTS, dateFr, lien, type Candidat, type Election } from "../../../../lib/data";

export async function getStaticPaths() {
  const routes = [];
  for (const election of await elections()) {
    for (const c of await candidatsDe(election)) {
      routes.push({ params: { election: election.id, candidat: slugCandidat(c) }, props: { c, election } });
    }
  }
  return routes;
}
const { c, election } = Astro.props as { c: Candidat; election: Election };
---
<Base titre={`${nomComplet(c)} · ${election.data.nom}`} page="elections" description={`Positions de ${nomComplet(c)} (${c.data.parti}) : ${election.data.nom}.`}>
  <BandeauVerif slot="bandeau" />
  <article class="sheet">
    <a class="back" href={lien(`/elections/${election.id}`)}>← {election.data.nom}</a>
    <div class="sheet-head">
      <div style="display:grid;gap:6px">
        <h2>{nomComplet(c)}</h2>
        <span style="color:var(--muted)">{c.data.parti}</span>
      </div>
      <span class="pill ok">{STATUTS[c.data.statut]}{c.data.declaration && ` · ${dateFr(c.data.declaration)}`}</span>
    </div>
    <p style="margin:0;max-width:65ch">{c.data.bio}</p>
    <div style="display:grid;gap:14px">
      <span class="label">Positions par thème</span>
      {election.data.themes.map((t) => (
        <div class="pos">
          <h3>{t.nom}</h3>
          <p><Position position={c.data.positions[t.id]} /></p>
        </div>
      ))}
    </div>
    <div class="analysis">
      <span class="label">Analyses · séparées des faits</span>
      {c.data.analyses.length ? (
        c.data.analyses.map((a) => (
          <div>
            <h3>{a.titre}</h3>
            <p>{a.resume}</p>
            <span class="mono src"><a href={a.source.url} rel="noopener">{a.source.titre}</a> · {dateFr(a.source.date)}</span>
          </div>
        ))
      ) : (
        <p>Aucune analyse publiée pour l'instant. Seules les évaluations d'organismes nommés (Cour des comptes, OFCE, Institut Montaigne, Fondation Jean-Jaurès…) figureront ici.</p>
      )}
    </div>
  </article>
</Base>
