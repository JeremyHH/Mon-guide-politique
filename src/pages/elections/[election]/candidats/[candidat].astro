---
import Base from "../../../../layouts/Base.astro";
import Position from "../../../../components/Position.astro";
import BandeauVerif from "../../../../components/BandeauVerif.astro";
import { elections, candidatsDe, nomComplet, slugCandidat, STATUTS, dateFr, lien, type Candidat, type Election } from "../../../../lib/data";

export async function getStaticPaths() {
  const routes = [];
  for (const election of await elections()) {
    for (const c of await candidatsDe(election)) {
      routes.push({ params: { election: election.id, candidat: slugCandidat(c) }, props: { c, election } });
    }
  }
  return routes;
}
const { c, election } = Astro.props as { c: Candidat; election: Election };
const STATUTS_JUSTICE = { definitive: "Définitive", non_definitive: "Non définitive (recours en cours)", non_precise: "Recours éventuels non précisés" } as const;
// Un poste est en cours quand sa période contient « depuis » (ex. « 2010 – 2017, depuis juillet 2020 »).
const enFonction = (periode: string) => /(^|,\s*)depuis\b/i.test(periode);
const RANG = { definitive: 0, non_definitive: 1, non_precise: 2 } as const;
const age = (d: Date) => {
  const n = new Date();
  return n.getFullYear() - d.getFullYear() - (n < new Date(n.getFullYear(), d.getMonth(), d.getDate()) ? 1 : 0);
};
---
<Base titre={`${nomComplet(c)} · ${election.data.nom}`} page="elections" description={`Positions de ${nomComplet(c)} (${c.data.parti}) : ${election.data.nom}.`}>
  <BandeauVerif slot="bandeau" />
  <article class="sheet">
    <a class="back" href={lien(`/elections/${election.id}`)}>← {election.data.nom}</a>
    <div class="sheet-head avec-photo">
      {c.data.photo && (
        <figure class="portrait">
          <img src={lien(c.data.photo.fichier)} alt={`Portrait de ${nomComplet(c)}`} width="360" height="480" />
          <figcaption>
            Photo ({c.data.photo.annee}) : {c.data.photo.auteur},{" "}
            <a href={c.data.photo.licenceUrl} rel="noopener license">{c.data.photo.licence}</a>,{" "}
            <a href={c.data.photo.source} rel="noopener">Wikimedia Commons</a>, recadrée
          </figcaption>
        </figure>
      )}
      <div class="sheet-ident">
        <h2>{nomComplet(c)}</h2>
        <span style="color:var(--muted)">{c.data.parti}</span>
        <span class="pill ok" style="justify-self:start">{STATUTS[c.data.statut]}{c.data.declaration && ` · ${dateFr(c.data.declaration)}`}</span>
      </div>
    </div>
    <p style="margin:0;max-width:65ch">{c.data.bio}</p>

    <nav class="sommaire" aria-label="Sections de la fiche">
      <a href="#biographie">Biographie</a>
      <a href="#parcours">Parcours politique</a>
      <a href="#resultats">Résultats électoraux</a>
      <a href="#positions">Positions</a>
      <a href="#justice">Condamnations</a>
    </nav>

    <section class="fiche-section" id="biographie">
      <h3 class="fiche-titre">Biographie</h3>
      {c.data.naissance && (
        <dl class="faits">
          <div><dt>Naissance</dt><dd>{dateFr(c.data.naissance.date)}, {c.data.naissance.lieu}</dd></div>
          <div><dt>Âge</dt><dd>{age(c.data.naissance.date)} ans</dd></div>
          <div><dt>Parti</dt><dd>{c.data.parti}</dd></div>
        </dl>
      )}
      {c.data.biographie ? <p class="fiche-texte">{c.data.biographie}</p> : <p class="none">Biographie à compléter.</p>}
    </section>

    <section class="fiche-section" id="parcours">
      <h3 class="fiche-titre">Fonctions politiques occupées</h3>
      {c.data.fonctions.length ? (
        <p class="legende-parcours"><span class="puce pleine" aria-hidden="true"></span> en fonction <span class="puce vide" aria-hidden="true"></span> fonction passée</p>
        <ol class="parcours">
          {c.data.fonctions.map((f) => (
            <li class={enFonction(f.periode) ? "en-cours" : undefined}>
              <span class="parcours-intitule">{f.intitule}</span>
              {f.periode && <span class="parcours-periode">{f.periode}{enFonction(f.periode) && <span class="sr-only"> (en fonction)</span>}</span>}
            </li>
          ))}
        </ol>
      ) : <p class="none">À compléter.</p>}
    </section>

    <section class="fiche-section" id="resultats">
      <h3 class="fiche-titre">Résultats aux élections passées</h3>
      {c.data.resultats.length ? (
        <div class="table-wrap">
          <table class="data resultats">
            <thead><tr><th>Année</th><th>Élection</th><th>Résultat</th></tr></thead>
            <tbody>
              {[...c.data.resultats].sort((a, b) => b.annee - a.annee).map((r) => (
                <tr><td class="mono">{r.annee}</td><th>{r.scrutin}</th><td>{r.resultat}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p class="none">À compléter.</p>}
    </section>

    <section class="fiche-section" id="positions">
      <h3 class="fiche-titre">Positions par thème</h3>
      {election.data.themes.map((t) => (
        <div class="pos">
          <h3>{t.nom}</h3>
          <p><Position position={c.data.positions[t.id]} /></p>
        </div>
      ))}
    </section>

    <section class="fiche-section" id="justice">
      <h3 class="fiche-titre">Condamnations judiciaires</h3>
      <p class="mono note-justice">Condamnations pénales connues : d'abord les décisions définitives, puis les autres, chaque groupe de la plus récente à la plus ancienne. Les relaxes et les litiges civils ne sont pas listés. Une décision non définitive peut encore être annulée : la personne reste présumée innocente tant que tous les recours ne sont pas épuisés.</p>
      {c.data.condamnations.length ? (
        <ul class="condamnations">
          {[...c.data.condamnations].sort((a, b) => RANG[a.statut] - RANG[b.statut]).map((k) => (
            <li class={`condamnation ${k.statut}`}>
              <div class="condamnation-tete">
                <span class="condamnation-date">{k.date}</span>
                <span class={`pill statut-${k.statut}`}>{STATUTS_JUSTICE[k.statut]}</span>
              </div>
              <p class="condamnation-motif">{k.motif}</p>
              <p class="condamnation-peine">{k.juridiction} · {k.peine}</p>
              {k.detail && <p class="condamnation-detail">{k.detail}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="aucune">Aucune condamnation pénale connue.</p>
      )}
      {c.data.procedures.length > 0 && (
        <div class="procedures">
          <span class="label">Procédures en cours</span>
          {c.data.procedures.map((t) => <p>{t}</p>)}
        </div>
      )}
    </section>

    {c.data.sourcesProfil.length > 0 && (
      <p class="mono src">Sources de la biographie, du parcours, des résultats et des condamnations :{" "}
        {c.data.sourcesProfil.map((s, i) => <>{i > 0 && " · "}<a href={s.url} rel="noopener">{s.titre}</a></>)}
      </p>
    )}

    <div class="analysis">
      <span class="label">Analyses · séparées des faits</span>
      {c.data.analyses.length ? (
        c.data.analyses.map((a) => (
          <div>
            <h3>{a.titre}</h3>
            <p>{a.resume}</p>
            <span class="mono src"><a href={a.source.url} rel="noopener">{a.source.titre}</a> · {dateFr(a.source.date)}</span>
          </div>
        ))
      ) : (
        <p>Aucune analyse publiée pour l'instant. Seules les évaluations d'organismes nommés (Cour des comptes, OFCE, Institut Montaigne, Fondation Jean-Jaurès…) figureront ici.</p>
      )}
    </div>
  </article>
</Base>
