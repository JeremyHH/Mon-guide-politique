---
import Base from "../../../layouts/Base.astro";
import NavElection from "../../../components/NavElection.astro";
import BandeauVerif from "../../../components/BandeauVerif.astro";
import Frise from "../../../components/Frise.astro";
import { elections, candidatsDe, compteCandidats, presidentiellesPassees, nomComplet, slugCandidat, STATUTS, lien, type Election } from "../../../lib/data";

export async function getStaticPaths() {
  return (await elections()).map((e) => ({ params: { election: e.id }, props: { election: e } }));
}
const { election } = Astro.props as { election: Election };
const liste = await candidatsDe(election);
const compte = await compteCandidats(election);
// Groupement sur un critère objectif (représentation au Parlement), jamais sur les sondages.
const groupes = [
  {
    titre: "Candidats de partis représentés au Parlement",
    critere: "Investis ou soutenus par un parti ayant un groupe à l'Assemblée nationale ou au Sénat, ou des élus au Parlement européen (y compris la primaire PS – Place publique).",
    liste: liste.filter((c) => c.data.representation),
  },
  {
    titre: "Autres candidatures",
    critere: "Partis sans groupe parlementaire ni élus européens, mouvements et candidatures indépendantes.",
    liste: liste.filter((c) => !c.data.representation),
  },
];
---
<Base titre={election.data.nom} page="elections" description={election.data.resume}>
  <BandeauVerif slot="bandeau" />
  <NavElection election={election} actif="apercu" />

  <div class="hero" style="align-items:center">
    <p class="lede" style="margin:0">{election.data.resume}</p>
    <div class="countdown">
      <span class="label">Premier tour</span>
      <span class="n" id="jours" data-cible={election.data.date.toISOString()}>—</span>
      <span class="mono">jours avant le {election.data.libelleDate.split(" et ")[0]}</span>
      <span class="compte-candidats">
        <span class="compte-ligne"><strong>{compte.total}</strong> candidatures déclarées</span>
        <span class="compte-detail">{[compte.primaire > 0 && `dont ${compte.primaire} à la primaire socialiste`, compte.pressentis > 0 && `et ${compte.pressentis} intention${compte.pressentis > 1 ? "s" : ""} de candidature non officielle${compte.pressentis > 1 ? "s" : ""}`].filter(Boolean).join(", ")}</span>
      </span>
    </div>
  </div>

  <div style="display:grid;gap:16px">
    <div class="section-head"><h2>Candidats</h2>
      <div class="tools">
        <span class="label">Ordre</span>
        <button class="chip" id="tri-alpha" aria-pressed="true">Alphabétique</button>
        <button class="chip" id="tri-hasard" aria-pressed="false">Aléatoire</button>
      </div>
    </div>
    <p class="lede" style="margin:0">{election.data.introCandidats}</p>
    {groupes.map((g) => g.liste.length > 0 && (
      <section class="groupe-candidats">
        <h3>{g.titre} <span class="mono groupe-n">{g.liste.length}</span></h3>
        <p class="mono groupe-critere">{g.critere}</p>
        <div class="ballots bulletins">
          {g.liste.map((c) => (
            <a class="ballot" href={lien(`/elections/${election.id}/candidats/${slugCandidat(c)}`)}>
              {c.data.photo ? <img class="ballot-photo" src={lien(c.data.photo.fichier)} alt="" width="120" height="160" loading="lazy" /> : <span class="ballot-photo sans-photo" title="Pas de photo sous licence libre disponible">{c.data.prenom[0]}{c.data.nom[0]}</span>}
              <span class="name">{nomComplet(c)}</span>
              <span class="party">{c.data.parti}</span>
              {presidentiellesPassees(c).length > 0 && (
                <span class="deja mono">Déjà candidat·e : {presidentiellesPassees(c).map((r) => `${r.annee} (${r.premierTour}${r.secondTour ? ", 2d tour" : ""})`).join(" · ")}</span>
              )}
              <span class="status"><span class="pill ok">{STATUTS[c.data.statut]}</span></span>
            </a>
          ))}
        </div>
      </section>
    ))}
    {election.data.autres.length > 0 && (
      <div class="others">
        <span class="label">Autres intentions de candidature</span>
        <ul>{election.data.autres.map((a) => <li>{a}</li>)}</ul>
      </div>
    )}
  </div>

  <Frise election={election} titre="Calendrier" />
</Base>

<script>
  import { compteARebours } from "../../../lib/temps";
  compteARebours(document.getElementById("jours")!);

  // Le tri s'applique à l'intérieur de chaque groupe.
  const boites = [...document.querySelectorAll<HTMLElement>(".bulletins")].map((box) => ({ box, initial: [...box.children] }));
  const alpha = document.getElementById("tri-alpha")!;
  const hasard = document.getElementById("tri-hasard")!;
  function melanger<T>(items: T[]) {
    const m = [...items];
    for (let i = m.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [m[i], m[j]] = [m[j], m[i]];
    }
    return m;
  }
  function tri(actif: HTMLElement) {
    for (const { box, initial } of boites) box.replaceChildren(...(actif === hasard ? melanger(initial) : initial));
    alpha.setAttribute("aria-pressed", String(actif === alpha));
    hasard.setAttribute("aria-pressed", String(actif === hasard));
  }
  alpha.onclick = () => tri(alpha);
  hasard.onclick = () => tri(hasard);
</script>
