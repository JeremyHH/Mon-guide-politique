---
import Base from "../../../layouts/Base.astro";
import NavElection from "../../../components/NavElection.astro";
import BandeauVerif from "../../../components/BandeauVerif.astro";
import Frise from "../../../components/Frise.astro";
import { logoParti, siteParti } from "../../../lib/partis";
import { elections, candidatsDe, compteCandidats, presidentiellesPassees, candidatUnique, nomComplet, slugCandidat, STATUTS, lien, type Election } from "../../../lib/data";

export async function getStaticPaths() {
  return (await elections()).map((e) => ({ params: { election: e.id }, props: { election: e } }));
}
const { election } = Astro.props as { election: Election };
const liste = await candidatsDe(election);
const compte = await compteCandidats(election);
// Groupement sur un critère objectif (représentation au Parlement), jamais sur les sondages.
const groupes = [
  {
    titre: "Candidats de partis représentés au Parlement",
    critere: "Investis ou soutenus par un parti ayant un groupe à l'Assemblée nationale ou au Sénat, ou des élus au Parlement européen (y compris la primaire PS – Place publique).",
    liste: liste.filter((c) => c.data.representation),
  },
  {
    titre: "Autres candidatures",
    critere: "Partis sans groupe parlementaire ni élus européens, mouvements et candidatures indépendantes.",
    liste: liste.filter((c) => !c.data.representation),
  },
];
---
<Base titre={election.data.nom} page="elections" description={election.data.resume}>
  <BandeauVerif slot="bandeau" />
  <NavElection election={election} actif="apercu" />

  <div class="hero" style="align-items:center">
    <p class="lede" style="margin:0">{election.data.resume}</p>
    <div class="countdown">
      <span class="label">Premier tour</span>
      <span class="n" id="jours" data-cible={election.data.date.toISOString()}>—</span>
      <span class="mono">jours avant le {election.data.libelleDate.split(" et ")[0]}</span>
      <span class="compte-candidats">
        <span class="compte-ligne"><strong>{compte.total}</strong> candidatures déclarées</span>
        <span class="compte-detail">{[compte.primaire > 0 && `dont ${compte.primaire} à la primaire socialiste`, compte.pressentis > 0 && `et ${compte.pressentis} intention${compte.pressentis > 1 ? "s" : ""} de candidature non officielle${compte.pressentis > 1 ? "s" : ""}`].filter(Boolean).join(", ")}</span>
      </span>
    </div>
  </div>

  <div style="display:grid;gap:16px">
    <div class="section-head"><h2>Candidats</h2>
      <div class="tools">
        <span class="label">Ordre</span>
        <button class="chip" id="tri-alpha" aria-pressed="true">Alphabétique</button>
        <button class="chip" id="tri-hasard" aria-pressed="false">Aléatoire</button>
      </div>
    </div>
    <p class="lede" style="margin:0">{election.data.introCandidats}</p>
    <form class="filtres" id="filtres" role="search" aria-label="Filtrer les candidats" onsubmit="return false">
      <label class="filtre-recherche">
        <span class="label">Rechercher</span>
        <input type="search" id="f-texte" placeholder="Nom ou parti" autocomplete="off" />
      </label>
      <label>
        <span class="label">Statut</span>
        <select id="f-statut">
          <option value="">Tous</option>
          {[...new Set(liste.map((c) => c.data.statut))].map((st) => <option value={st}>{STATUTS[st]}</option>)}
        </select>
      </label>
      <label class="filtre-case"><input type="checkbox" id="f-unique" /> Seule candidature du parti</label>
      <label class="filtre-case"><input type="checkbox" id="f-deja" /> Déjà candidat·e à une présidentielle</label>
      <button type="button" class="chip" id="f-reset">Réinitialiser</button>
      <p class="mono filtre-compte" id="f-compte" aria-live="polite"></p>
    </form>
    {groupes.map((g) => g.liste.length > 0 && (
      <section class="groupe-candidats" data-groupe>
        <h3>{g.titre} <span class="mono groupe-n">{g.liste.length}</span></h3>
        <p class="mono groupe-critere">{g.critere}</p>
        <div class="ballots bulletins">
          {g.liste.map((c) => (
            <div class="ballot-cell"
              data-texte={`${nomComplet(c)} ${c.data.parti}`.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase()}
              data-statut={c.data.statut}
              data-unique={candidatUnique(c, liste) ? "1" : "0"}
              data-deja={presidentiellesPassees(c).length > 0 ? "1" : "0"}>
            <div class="ballot">
              {c.data.photo ? <img class="ballot-photo" src={lien(c.data.photo.fichier)} alt="" width="120" height="160" loading="lazy" /> : <span class="ballot-photo sans-photo" title="Pas de photo sous licence libre disponible">{c.data.prenom[0]}{c.data.nom[0]}</span>}
              <a class="name ballot-lien" href={lien(`/elections/${election.id}/candidats/${slugCandidat(c)}`)}>{nomComplet(c)}</a>
              {siteParti(c.data.parti) ? (
                <a class="party party-lien" href={siteParti(c.data.parti)} rel="noopener" title={`Site de ${c.data.parti}`}>{logoParti(c.data.parti) && <img class="parti-logo-carte" src={lien(logoParti(c.data.parti)!.fichier)} alt="" height="24" loading="lazy" />}{c.data.parti}</a>
              ) : (
                <span class="party">{logoParti(c.data.parti) && <img class="parti-logo-carte" src={lien(logoParti(c.data.parti)!.fichier)} alt="" height="24" loading="lazy" />}{c.data.parti}</span>
              )}
              {candidatUnique(c, liste) && <span class="coche-ligne"><span class="coche" aria-hidden="true">✓</span> Seule candidature du parti</span>}
              {c.data.vainqueurPrimaire && <span class="pill vainqueur" title={`${c.data.vainqueurPrimaire.nom}${c.data.vainqueurPrimaire.resultat ? ` : ${c.data.vainqueurPrimaire.resultat}` : ""}`}>Vainqueur de la primaire</span>}
              {presidentiellesPassees(c).length > 0 && (
                <span class="deja mono">Déjà candidat·e : {presidentiellesPassees(c).map((r) => `${r.annee} (${r.premierTour}${r.secondTour ? ", 2d tour" : ""})`).join(" · ")}</span>
              )}
              <span class="status"><span class="pill ok">{STATUTS[c.data.statut]}</span></span>
            </div>
            {c.data.site && (
              <a class="ballot-site" href={c.data.site.url} rel="noopener" aria-label={`Site officiel de ${nomComplet(c)}`}>
                {new URL(c.data.site.url).hostname.replace(/^www\./, "")} ↗
              </a>
            )}
            </div>
          ))}
        </div>
      </section>
    ))}
    {election.data.autres.length > 0 && (
      <div class="others">
        <span class="label">Autres intentions de candidature</span>
        <ul>{election.data.autres.map((a) => <li>{a}</li>)}</ul>
      </div>
    )}
  </div>

  <Frise election={election} titre="Calendrier" />
</Base>

<script>
  import { compteARebours } from "../../../lib/temps";
  compteARebours(document.getElementById("jours")!);

  // Le tri s'applique à l'intérieur de chaque groupe.
  const boites = [...document.querySelectorAll<HTMLElement>(".bulletins")].map((box) => ({ box, initial: [...box.children] }));
  const alpha = document.getElementById("tri-alpha")!;
  const hasard = document.getElementById("tri-hasard")!;
  function melanger<T>(items: T[]) {
    const m = [...items];
    for (let i = m.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [m[i], m[j]] = [m[j], m[i]];
    }
    return m;
  }
  function tri(actif: HTMLElement) {
    for (const { box, initial } of boites) box.replaceChildren(...(actif === hasard ? melanger(initial) : initial));
    alpha.setAttribute("aria-pressed", String(actif === alpha));
    hasard.setAttribute("aria-pressed", String(actif === hasard));
  }
  alpha.onclick = () => tri(alpha);
  hasard.onclick = () => tri(hasard);

  // Filtres : n'agissent que sur l'affichage (attribut hidden), compatibles avec le tri.
  const fTexte = document.getElementById("f-texte") as HTMLInputElement;
  const fStatut = document.getElementById("f-statut") as HTMLSelectElement;
  const fUnique = document.getElementById("f-unique") as HTMLInputElement;
  const fDeja = document.getElementById("f-deja") as HTMLInputElement;
  const fCompte = document.getElementById("f-compte")!;
  const norm = (t: string) => t.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase().trim();
  function filtrer() {
    const q = norm(fTexte.value);
    let n = 0;
    const cells = [...document.querySelectorAll<HTMLElement>(".ballot-cell")];
    for (const el of cells) {
      const ok =
        (!q || (el.dataset.texte ?? "").includes(q)) &&
        (!fStatut.value || el.dataset.statut === fStatut.value) &&
        (!fUnique.checked || el.dataset.unique === "1") &&
        (!fDeja.checked || el.dataset.deja === "1");
      el.hidden = !ok;
      if (ok) n++;
    }
    for (const g of document.querySelectorAll<HTMLElement>("[data-groupe]")) {
      g.hidden = !g.querySelector(".ballot-cell:not([hidden])");
    }
    fCompte.textContent = n === cells.length ? `${n} fiches affichées` : `${n} fiche${n > 1 ? "s" : ""} sur ${cells.length}`;
  }
  for (const el of [fTexte, fStatut, fUnique, fDeja]) el.addEventListener("input", filtrer);
  document.getElementById("f-reset")!.onclick = () => {
    fTexte.value = ""; fStatut.value = ""; fUnique.checked = false; fDeja.checked = false; filtrer();
  };
  filtrer();
</script>
