---
import Base from "../../layouts/Base.astro";
import { fiches, lien } from "../../lib/data";

const liste = await fiches("institutions");
---
<Base titre="Les institutions" page="institutions">
  <div>
    <h2 style="font-size:2rem">Les institutions</h2>
    <p class="lede">Qui fait quoi dans la République : les pouvoirs, leurs limites et la façon dont ils se contrôlent les uns les autres.</p>
  </div>
  <div class="cards">
    {liste.map((f) => (
      <a class="card" href={lien(`/institutions/${f.id.split("/")[1]}`)}>
        <h3>{f.data.titre}</h3>
        <p>{f.data.resume}</p>
      </a>
    ))}
  </div>
</Base>
