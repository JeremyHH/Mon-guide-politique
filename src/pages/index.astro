---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { lien } from "../lib/data";

const etapes = (await getCollection("calendrier")).sort((a, b) => +a.data.date - +b.data.date);
const tour1 = etapes.find((e) => e.id === "tour-1")!.data.date;
const nbQuestions = (await getCollection("quiz")).length;
---
<Base titre="Accueil" page="accueil">
  <div class="hero">
    <div>
      <span class="label">Élection présidentielle · France</span>
      <h1>Qui propose quoi, thème par thème.</h1>
      <p class="lede">Les mêmes questions posées à chaque candidat déclaré, les réponses tirées de leurs programmes et déclarations, avec la source et la date à chaque fois.</p>
    </div>
    <div class="countdown">
      <span class="label">Premier tour · avril 2027</span>
      <span class="n" id="jours" data-cible={tour1.toISOString()}>—</span>
      <span class="mono">jours avant le 11 avril 2027 (date indicative)</span>
    </div>
  </div>
  <div class="entries">
    <a class="entry" href={lien("/candidats")}><span class="label">Fiches</span><h3>Voir les candidats</h3><p>Parcours, parti, statut de la candidature et positions par thème.</p></a>
    <a class="entry" href={lien("/comparer")}><span class="label">Comparateur</span><h3>Comparer les positions</h3><p>Tous les candidats sur un thème, ou deux candidats face à face.</p></a>
    <a class="entry" href={lien("/quiz")}><span class="label">Quiz</span><h3>Qui me ressemble ?</h3><p>Donnez votre avis sur {nbQuestions} affirmations. Rien n'est envoyé ni enregistré.</p></a>
  </div>
  <div>
    <h2 style="font-size:1.4rem;margin-bottom:14px">Calendrier</h2>
    <ol class="timeline" id="calendrier">
      {etapes.map((e) => (
        <li data-date={e.data.date.toISOString()}>
          <span class="d">{e.data.quand}</span>
          <span>{e.data.quoi}</span>
        </li>
      ))}
    </ol>
  </div>
</Base>

<script>
  // Calculé dans le navigateur pour rester juste sans reconstruire le site chaque jour.
  const now = Date.now();
  const el = document.getElementById("jours")!;
  el.textContent = String(Math.max(0, Math.ceil((Date.parse(el.dataset.cible!) - now) / 86400000)));
  let suivante = false;
  document.querySelectorAll<HTMLLIElement>("#calendrier li").forEach((li) => {
    if (Date.parse(li.dataset.date!) + 86400000 < now) li.classList.add("past");
    else if (!suivante) {
      suivante = true;
      li.classList.add("next");
      li.lastElementChild!.insertAdjacentHTML("afterbegin", "<strong>Prochaine étape · </strong>");
    }
  });
</script>
