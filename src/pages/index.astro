---
import Base from "../layouts/Base.astro";
import Frise from "../components/Frise.astro";
import { RUBRIQUES } from "../lib/config";
import { elections, fiches, lien, compteCandidats } from "../lib/data";

const aVenir = (await elections()).filter((e) => +e.data.date >= Date.now() - 86400000 * 30);
const prochaine = aVenir[0];
const compte = prochaine ? await compteCandidats(prochaine) : null;
const institutions = RUBRIQUES.institutions ? (await fiches("institutions")).slice(0, 4) : [];
const voter = await fiches("voter");
const slug = (id: string) => id.split("/")[1];
---
<Base titre="Accueil" page="accueil">
  <div class="hero bandeau">
    <div>
      <span class="label">Vie démocratique · France</span>
      <h1>Comprendre, voter, <em>choisir</em>.</h1>
      <p class="lede">{RUBRIQUES.institutions && "Comment fonctionnent les institutions, "}Comment s'inscrire et voter, et ce que proposent les candidats à chaque élection. Neutre, sourcé, sans publicité ni collecte de données.</p>
    </div>
    {prochaine && (
      <a class="countdown" href={lien(`/elections/${prochaine.id}`)}>
        <span class="label">Prochaine élection · {prochaine.data.nom}</span>
        <span class="n" id="jours" data-cible={prochaine.data.date.toISOString()}>—</span>
        <span class="mono">jours avant le premier tour ({prochaine.data.libelleDate})</span>
        {compte && (
          <span class="compte-candidats">
            <span class="compte-ligne"><strong>{compte.total}</strong> candidatures déclarées</span>
            <span class="compte-detail">dont {compte.suivis} détaillées sur le site{compte.primaire > 0 && ` (${compte.primaire} à la primaire socialiste)`}</span>
          </span>
        )}
      </a>
    )}
  </div>

  {prochaine && <Frise election={prochaine} titre={`${prochaine.data.menu ?? prochaine.data.nom} : les grandes étapes`} lienElection />}

  <div class={RUBRIQUES.institutions ? "entries" : "entries deux"}>
    {RUBRIQUES.institutions && <a class="entry bleu" href={lien("/institutions")}><span class="label">Comprendre</span><h3>Les institutions</h3><p>Président, gouvernement, Parlement, Conseil constitutionnel, collectivités, Union européenne.</p></a>}
    <a class="entry rouge" href={lien("/voter")}><span class="label">Agir</span><h3>Voter</h3><p>Inscription sur les listes, procuration, modes de scrutin, référendum.</p></a>
    <a class="entry tricolore" href={lien("/elections")}><span class="label">Choisir</span><h3>Les élections</h3><p>Candidats et positions comparées thème par thème{RUBRIQUES.quiz && ", quiz de proximité"}.</p></a>
  </div>

  {institutions.length > 0 && <div style="display:grid;gap:14px">
    <div class="section-head"><h2>Les institutions en bref</h2><a href={lien("/institutions")}>Toutes les fiches →</a></div>
    <div class="cards">
      {institutions.map((f) => (
        <a class="card bleu" href={lien(`/institutions/${slug(f.id)}`)}><h3>{f.data.titre}</h3><p>{f.data.resume}</p></a>
      ))}
    </div>
  </div>}

  <div style="display:grid;gap:14px">
    <div class="section-head"><h2>Avant d'aller voter</h2><a href={lien("/voter")}>Guide complet →</a></div>
    <div class="cards">
      {voter.map((f) => (
        <a class="card rouge" href={lien(`/voter/${slug(f.id)}`)}><h3>{f.data.titre}</h3><p>{f.data.resume}</p></a>
      ))}
    </div>
  </div>
</Base>

<script>
  import { compteARebours } from "../lib/temps";
  const el = document.getElementById("jours");
  if (el) compteARebours(el);
</script>
